{
  "name": "beginner-portfolio",
  "version": "1.0.0",
  "description": "Single-server React (Vite) portfolio with Express",
  "type": "module",
  "scripts": {
    "dev": "npm install --silent || true; npm --prefix client install --silent || true; node server/index.js",
    "build": "npm --prefix client run build",
    "start": "node server/index.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "nodemailer": "^6.9.14"
  },
  "devDependencies": {
    "vite": "^5.4.10"
  }
}
